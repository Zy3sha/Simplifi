{
  "name": "obubba",
  "version": "1.0.0",
  "description": "OBubba — Smart Baby Tracker with full native iOS & Android support",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "./build-pwa.sh",
    "build:seo": "node tools/render-seo.mjs",
    "blog:build": "node tools/render-seo.mjs",
    "build:vite": "vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:build:ios": "npm run build && npx cap sync ios",
    "cap:build:android": "npm run build && npx cap sync android",
    "postinstall": "patch-package",
    "test:sleep": "node test/sleep-engine-audit.js",
    "test:day-boundary": "node test/day-boundary-audit.js",
    "test:imported-data": "node test/imported-data-safety-audit.js",
    "test:bubba-hug": "node test/bubba-hug-audit.js",
    "test": "npm run test:sleep && npm run test:day-boundary && npm run test:imported-data && npm run test:bubba-hug"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@capacitor-community/apple-sign-in": "^6.0.0",
    "@capacitor-community/firebase-analytics": "^6.0.0",
    "@capacitor-community/speech-recognition": "^6.0.0",
    "@capacitor-community/sqlite": "6.0.2",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/screen-orientation": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capawesome/capacitor-app-shortcuts": "^6.0.0",
    "@capawesome/capacitor-badge": "^6.0.0",
    "@capawesome/capacitor-live-update": "^6.0.0",
    "firebase": "^10.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
