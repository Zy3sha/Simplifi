<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="180"
                android:startColor="#B0FDF6F0"
                android:endColor="#80F5E6DA"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:type="radial"
                android:centerX="0.1"
                android:centerY="0.9"
                android:gradientRadius="150dp"
                android:startColor="#14C07088"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:type="radial"
                android:centerX="0.9"
                android:centerY="0.1"
                android:gradientRadius="150dp"
                android:startColor="#18F0D0A0"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <stroke android:width="0.5dp" android:color="#30F0D0C8" />
        </shape>
    </item>
</layer-list>
