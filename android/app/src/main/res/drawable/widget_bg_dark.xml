<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: semi-transparent dark with warm tint -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="180"
                android:startColor="#90122741"
                android:endColor="#A0081527"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle warm glow bottom-left -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:type="radial"
                android:centerX="0.1"
                android:centerY="0.9"
                android:gradientRadius="160dp"
                android:startColor="#18FF8B56"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Subtle purple glow top-right -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:type="radial"
                android:centerX="0.9"
                android:centerY="0.1"
                android:gradientRadius="160dp"
                android:startColor="#128B7EC8"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Thin glass edge -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <stroke android:width="0.5dp" android:color="#20FFFFFF" />
        </shape>
    </item>
</layer-list>
