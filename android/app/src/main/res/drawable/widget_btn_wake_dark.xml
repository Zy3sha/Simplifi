<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#E8E4BC68"
                android:centerColor="#CFB77A42"
                android:endColor="#BB946A35"
                android:type="linear" />
            <stroke android:width="0.75dp" android:color="#86FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
