<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#CCFFFFFF"
                android:centerColor="#76F8FCFF"
                android:endColor="#308FCBFF"
                android:type="linear" />
            <stroke android:width="0.75dp" android:color="#C8FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="radial"
                android:centerX="0.84"
                android:centerY="0.08"
                android:gradientRadius="95dp"
                android:startColor="#4C8FCBFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
            <gradient
                android:angle="270"
                android:startColor="#70FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
