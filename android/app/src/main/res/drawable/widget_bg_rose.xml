<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="135"
                android:startColor="#F7FFFAF8"
                android:centerColor="#F1F6E8E4"
                android:endColor="#E9F2DCE5"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#72FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <stroke android:width="0.5dp" android:color="#32C07088" />
        </shape>
    </item>
</layer-list>
